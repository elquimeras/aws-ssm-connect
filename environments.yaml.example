# Environment configuration for AWS Connection Manager
# Reference template. The working config lives in environments.yaml (tracked in
# this private repo). It holds AWS profile names and infrastructure identifiers
# (jump hosts, cluster/replication-group ids, domains) — not credentials.
#
# PORTS: `port` is the REMOTE port the tunnel connects to. `local_port` is
# optional and changes only YOUR side, so the default port stays free for a
# service already running locally. Setting `port` to a value the remote does
# not listen on makes the tunnel open and then die on first use.
# Precedence: --local-port > local_port > per-command default.
# `eks` is the exception: its remote port is always 443, so there `port` already
# means the local port and `local_port` just overrides it.

rds:
  my-environment:
    profile: my-aws-profile
    jumphost: My Jump Host
    cluster: my-cluster-name
    port: '5432'                       # remote port on the DB
    # local_port: '5433'               # optional: local side of the tunnel (default: 5432)
    # profile_cluster: other-profile   # optional: different profile for the cluster
    # region: us-west-2                # optional: defaults to us-east-1

redis:
  my-environment:
    profile: my-aws-profile
    jumphost: My Jump Host
    cluster: my-replication-group-id
    # endpoint: my-endpoint.cache.amazonaws.com  # fallback: literal endpoint, no AWS lookup
    port: '6379'                       # remote port on ElastiCache
    # local_port: '6378'               # optional: local side of the tunnel (default: 6379)
    # warning: 'Warning message'       # optional
    # region: us-west-2                # optional: defaults to us-east-1

docdb:
  production:
    profile: my-aws-profile
    jumphost: My Jump Host
    endpoint: my-cluster.cluster-xxxx.us-west-2.docdb.amazonaws.com
    port: '27017'                      # remote port on DocumentDB
    # local_port: '28017'              # optional: local side of the tunnel (default: same as port)
    # region: us-west-2                # optional: defaults to us-east-1
    # warning: 'Warning message'       # optional

eks:
  my-environment:
    profile: my-k8s-profile
    jumphost: My Jump Host
    cluster: my-eks-cluster
    port: '8443'                       # local port (the EKS remote port is always 443)
    # local_port: '9443'               # optional: overrides `port` for the local side
    # account_id: '123456789012'       # optional: skips an AWS lookup on --configure-kubeconfig
    # region: us-west-2                # optional: defaults to us-east-1

opensearch:
  my-environment:
    profile: my-aws-profile
    jumphost: My Jump Host
    domain: my-domain
    # region: us-west-2                # optional: defaults to us-east-1

ec2:
  my-environment:
    profile: my-aws-profile
    jumphost: My Jump Host
    # region: us-west-2                # optional: defaults to us-east-1
