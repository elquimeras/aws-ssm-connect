#!/usr/bin/env python3
import os
import sys

# Resolve symlinks so aws_connect.py is found next to the real script,
# regardless of how or from where this wrapper is invoked.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

try:
    from aws_connect import cli
except ModuleNotFoundError as exc:
    if exc.name != "aws_connect":
        raise
    print("❌ Error: aws_connect.py not found next to this wrapper.", file=sys.stderr)
    print("   Run it from a full checkout of the repository.", file=sys.stderr)
    sys.exit(1)

if __name__ == '__main__':
    cli()
